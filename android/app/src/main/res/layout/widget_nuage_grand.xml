<?xml version="1.0" encoding="utf-8"?>
<!-- Disposition « grande » (~4×3 et plus) : grande scène, météo détaillée, vanne mise en avant.
     Mêmes ids que les autres tailles → rendu partagé (WidgetRender). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp"
    android:background="@drawable/widget_bg">

    <ImageView
        android:id="@+id/widget_nuage"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:scaleType="fitCenter"
        android:src="@drawable/nuage_taquin_radieux"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/widget_temp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="42sp"
        android:textStyle="bold"
        android:textColor="#33414F"
        android:layout_marginTop="4dp"
        android:text="" />

    <TextView
        android:id="@+id/widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textColor="#33414F"
        android:maxLines="1"
        android:text="" />

    <TextView
        android:id="@+id/widget_minmax"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="#33414F"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:text="" />

    <TextView
        android:id="@+id/widget_vanne"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textStyle="italic"
        android:textColor="#4A5A6A"
        android:gravity="center"
        android:maxLines="3"
        android:ellipsize="end"
        android:layout_marginTop="10dp"
        android:text="" />
</LinearLayout>
